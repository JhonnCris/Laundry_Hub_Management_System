APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ssk_laba_dami
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: passwords for seeded demo accounts (random ones are generated if empty)
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=

# --- "Ready for pickup" customer notifications (both free) ---
# Email: any SMTP works. Free examples: Gmail (smtp.gmail.com, port 587, use an App Password)
# or Brevo (smtp-relay.brevo.com, port 587, 300 emails/day free). Set MAIL_MAILER=smtp to really send.
# SMS: SMS_DRIVER=log (nothing sent) | android (your phone as gateway, free) | textbelt (1 free text/day, mostly US/Canada)
SMS_DRIVER=log
SMS_ANDROID_URL=
SMS_ANDROID_USER=
SMS_ANDROID_PASSWORD=

# --- Firebase Cloud Messaging push (optional, free) ---
# Firebase console > Project settings. Put the downloaded service-account JSON at the path below (never commit it).
FCM_PROJECT_ID=
FCM_CREDENTIALS=storage/app/firebase-service-account.json
FCM_WEB_API_KEY=
FCM_WEB_AUTH_DOMAIN=
FCM_WEB_SENDER_ID=
FCM_WEB_APP_ID=
FCM_WEB_VAPID_KEY=

# --- Receipts ---
SHOP_NAME="SSK Laba Dami"
SHOP_TAGLINE="Laundry Hub"
SHOP_ADDRESS="Matina, Davao City"
SHOP_CLAIM_DAYS=7

# --- Vercel / hosted database ---
# Firebase key without a file: base64 of the service-account JSON (PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json")))
FCM_CREDENTIALS_BASE64=
# TiDB Cloud / any TLS database: path to the CA bundle (Vercel: /etc/pki/tls/certs/ca-bundle.crt)
MYSQL_ATTR_SSL_CA=
